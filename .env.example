# Copy to apps/web/.env.local (the Next.js app root), not the repository root.
# Phase 1 runtime requirements:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Signed links: at least 32 random characters. Used when links are issued.
APP_SECRET=

# Phase 2: OpenAI and Jinko. No default model or provider URL.
OPENAI_API_KEY=
OPENAI_MODEL=
JINKO_MCP_URL=
JINKO_API_KEY=
# Optional; an empty value defaults to Authorization (Bearer).
JINKO_API_KEY_HEADER=Authorization

# Phase 3: same Google OAuth application configured in Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 4 simulation endpoint: at least 32 random characters.
SIMULATION_SECRET=
